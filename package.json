{
  "name": "fastify-app",
  "version": "2.2.2",
  "description": "A simple fastify app template for JSON API server with helpful routes and initial settings.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "hooks:install": "node scripts/setup-git-hooks.mjs",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "homepage": "https://github.com/zhiyi7/fastify-app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhiyi7/fastify-app.git"
  },
  "keywords": [
    "fastify",
    "api",
    "server",
    "template",
    "web server",
    "http server"
  ],
  "author": "Zhiyi",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
