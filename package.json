{
  "name": "fastify-app",
  "version": "2.2.1",
  "description": "A simple fastify app template for JSON API server with helpful routes and initial settings.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup --config tsup.config.js",
    "hooks:install": "node scripts/setup-git-hooks.mjs",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "homepage": "https://github.com/zhiyi7/fastify-app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhiyi7/fastify-app.git"
  },
  "keywords": [
    "fastify",
    "api",
    "server",
    "template",
    "web server",
    "http server"
  ],
  "author": "Zhiyi",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
